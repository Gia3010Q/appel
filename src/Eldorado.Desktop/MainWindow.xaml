<Window x:Class="Eldorado.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eldorado · Quản lý shop" Width="1320" Height="850" MinWidth="1060" MinHeight="680" WindowStartupLocation="CenterScreen" Loaded="WindowLoaded" Closing="WindowClosing" StateChanged="WindowStateChanged">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="215"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#0B111C"><DockPanel>
      <StackPanel DockPanel.Dock="Top" Margin="24,30,20,30"><TextBlock Text="ELDORADO" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Accent}"/><TextBlock Text="Quản lý shop cá nhân" Margin="0,7,0,0" Foreground="{StaticResource Muted}"/></StackPanel>
      <StackPanel DockPanel.Dock="Bottom" Margin="22,20"><TextBlock Text="Windows · Seller API" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock Text="Đóng cửa sổ để chạy ở khay hệ thống." Margin="0,9,0,0" Foreground="{StaticResource Muted}" FontSize="12"/><Button Content="Thoát ứng dụng" Click="QuitClick" Margin="0,18,0,0" Padding="10,8"/></StackPanel>
      <StackPanel><RadioButton x:Name="OrdersNav" GroupName="Navigation" Content="Đơn hàng" Tag="0" Style="{StaticResource NavButton}" Checked="Navigate"/><RadioButton x:Name="OffersNav" GroupName="Navigation" Content="Offer" Tag="1" Style="{StaticResource NavButton}" Checked="Navigate"/><RadioButton x:Name="BoostNav" GroupName="Navigation" Content="Cày thuê" Tag="2" Style="{StaticResource NavButton}" Checked="Navigate"/><RadioButton x:Name="SettingsNav" GroupName="Navigation" Content="Kết nối shop" Tag="3" Style="{StaticResource NavButton}" Checked="Navigate"/></StackPanel>
    </DockPanel></Border>
    <Grid Grid.Column="1" Margin="28,25,28,18">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageTitle" Text="Đơn hàng" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="PageHint" Text="Theo dõi đơn mới và thời gian giao hàng." Margin="0,7,0,0" Foreground="{StaticResource Muted}"/></StackPanel><Button x:Name="RefreshButton" Grid.Column="1" Content="Làm mới" Click="RefreshClick" VerticalAlignment="Center" Style="{StaticResource PrimaryButton}"/></Grid>
      <Grid Grid.Row="1" x:Name="WorkArea">
        <Grid x:Name="OrdersPage">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="OrderSearch" ToolTip="Tìm mã đơn, dịch vụ, game hoặc người mua" TextChanged="OrderFilterChanged"/><CheckBox x:Name="PendingOnly" Grid.Column="1" Content="Chờ giao" Margin="18,12,10,0" Checked="OrderFilterChanged" Unchecked="OrderFilterChanged"/><CheckBox x:Name="BoostOrdersOnly" Grid.Column="2" Content="Đơn cày thuê" Margin="10,12,0,0" Checked="OrderFilterChanged" Unchecked="OrderFilterChanged"/></Grid>
          <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
            <DataGrid x:Name="OrdersGrid" SelectionChanged="OrderSelected"><DataGrid.Columns><DataGridTextColumn Header="Dịch vụ / game" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="Người mua" Binding="{Binding Buyer}" Width="110"/><DataGridTextColumn Header="Trạng thái" Binding="{Binding State}" Width="105"/><DataGridTextColumn Header="Giá" Binding="{Binding Price}" Width="75"/></DataGrid.Columns></DataGrid>
            <Border Grid.Column="2" Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Chi tiết đơn" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="OrderDetails" Text="Chọn một đơn để xem thông tin." Margin="0,18,0,20" Foreground="#C7D2E3"/><Button x:Name="DeliverButton" Content="Đánh dấu đã giao" Click="DeliverClick" IsEnabled="False" Style="{StaticResource PrimaryButton}"/><Button Content="Mở chat Eldorado" Click="OpenChatClick"/><Button Content="Mở Dashboard" Click="OpenDashboardClick"/></StackPanel></ScrollViewer></Border>
          </Grid>
        </Grid>
        <Grid x:Name="OffersPage" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBox x:Name="OfferSearch" ToolTip="Tìm tên offer hoặc mã game" TextChanged="OfferFilterChanged"/>
          <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
            <DataGrid x:Name="OffersGrid" SelectionChanged="OfferSelected"><DataGrid.Columns><DataGridTextColumn Header="Offer" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="Loại" Binding="{Binding Kind}" Width="90"/><DataGridTextColumn Header="Giá" Binding="{Binding Price}" Width="75"/><DataGridTextColumn Header="Tiền" Binding="{Binding Currency}" Width="65"/><DataGridTextColumn Header="SL" Binding="{Binding Quantity}" Width="65"/></DataGrid.Columns></DataGrid>
            <Border Grid.Column="2" Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Chỉnh sửa offer" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="OfferDetails" Text="Chọn một offer để chỉnh sửa." Margin="0,18,0,18" Foreground="#C7D2E3"/><TextBlock Text="Giá mới"/><TextBox x:Name="OfferPrice"/><Button x:Name="SavePriceButton" Content="Kiểm tra và lưu giá" Click="SavePriceClick" IsEnabled="False" Style="{StaticResource PrimaryButton}"/><TextBlock Text="Số lượng mới" Margin="0,12,0,0"/><TextBox x:Name="OfferQuantity"/><Button x:Name="SaveQuantityButton" Content="Kiểm tra và lưu số lượng" Click="SaveQuantityClick" IsEnabled="False"/></StackPanel></ScrollViewer></Border>
          </Grid>
        </Grid>
        <Grid x:Name="BoostPage" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="#303129" CornerRadius="8" Padding="14" Margin="0,0,0,16"><TextBlock Text="API trả về mã game, danh mục và người mua. Mở Eldorado để đọc đầy đủ yêu cầu trước khi báo giá. Bạn chủ động chọn đơn vị tiền." Foreground="#E8D89D"/></Border>
          <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Yêu cầu đã nhận · mới nhất 50" FontWeight="SemiBold" Margin="0,0,0,12"/><DataGrid Grid.Row="1" x:Name="RequestsGrid" SelectionChanged="RequestSelected"><DataGrid.Columns><DataGridTextColumn Header="Dịch vụ" Binding="{Binding Category}" Width="*"/><DataGridTextColumn Header="Game ID" Binding="{Binding Game}" Width="90"/><DataGridTextColumn Header="Người mua" Binding="{Binding Buyer}" Width="110"/></DataGrid.Columns></DataGrid><WrapPanel Grid.Row="2" Margin="0,16,0,0"><Button Content="Mở yêu cầu trên Eldorado" Click="OpenDashboardClick"/><Button Content="Xem đơn cày đã nhận" Click="ShowBoostOrdersClick"/></WrapPanel></Grid>
            <Border Grid.Column="2" Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Báo giá cho khách" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="RequestDetails" Text="Chọn yêu cầu của khách." Margin="0,14,0,14" Foreground="#C7D2E3"/><TextBlock Text="Giá đề xuất"/><TextBox x:Name="QuotePrice"/><TextBlock Text="Đơn vị tiền"/><ComboBox x:Name="QuoteCurrency"/><TextBlock Text="Thời gian hoàn thành"/><ComboBox x:Name="QuoteDelivery"/><TextBlock x:Name="QuoteStatus" Text="Bản nháp" Foreground="{StaticResource Accent}" Margin="0,0,0,14"/><WrapPanel><Button x:Name="SaveDraftButton" Content="Lưu nháp" Click="SaveDraftClick" IsEnabled="False"/><Button x:Name="CopyQuoteButton" Content="Sao chép" Click="CopyQuoteClick" IsEnabled="False"/></WrapPanel><Button x:Name="SendQuoteButton" Content="Kiểm tra và gửi báo giá" Click="SendQuoteClick" IsEnabled="False" Style="{StaticResource PrimaryButton}"/><Button x:Name="ResolveQuoteButton" Content="Đối chiếu kết quả trên Eldorado" Click="ResolveQuoteClick" Visibility="Collapsed"/><TextBlock Text="Chỉ hiện Đã gửi sau khi Eldorado xác nhận. Nếu mất kết nối trong lúc gửi, hãy kiểm tra trên website trước khi gửi lại." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,12,0,0"/></StackPanel></ScrollViewer></Border>
          </Grid>
        </Grid>
        <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="620" HorizontalAlignment="Left"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Kết nối một shop" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Nhập thông tin được tạo từ Dashboard → Seller API. Secret được lưu trong Windows Credential Manager trên máy này." Foreground="{StaticResource Muted}" Margin="0,12,0,24"/><TextBlock Text="Client ID"/><TextBox x:Name="ClientIdInput"/><TextBlock Text="Client Secret"/><PasswordBox x:Name="ClientSecretInput"/><TextBlock x:Name="CredentialHint" Foreground="{StaticResource Muted}" Margin="0,0,0,16"/><WrapPanel><Button Content="Lưu và kết nối" Click="ConnectClick" Style="{StaticResource PrimaryButton}"/><Button Content="Ngắt kết nối và xóa secret" Click="DisconnectClick"/></WrapPanel><Button Content="Mở trang Seller API" Click="OpenSellerApiClick"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,20,0,0"><StackPanel><TextBlock Text="Đồng bộ và thông báo" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Kiểm tra đơn và yêu cầu mới mỗi 60 giây khi app chạy. Khi Eldorado giới hạn lượt gọi, app sẽ chờ lâu hơn. Mỗi lần đọc tối đa 50 bản ghi mới nhất. Lần đầu kết nối dùng làm mốc và không thông báo các đơn cũ." Foreground="{StaticResource Muted}" Margin="0,12,0,0"/><TextBlock Text="Thu nhỏ hoặc đóng cửa sổ để chạy ở khay hệ thống. Chọn Thoát ứng dụng để dừng hoàn toàn." Foreground="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel></Border></StackPanel></ScrollViewer>
      </Grid>
      <Border Grid.Row="2" BorderBrush="#2A3649" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,13,0,0"><TextBlock x:Name="StatusText" Text="Chưa kết nối shop. Nhập credentials để bắt đầu." Foreground="{StaticResource Muted}"/></Border>
    </Grid>
  </Grid>
</Window>
